# ================================
# OGT Webhook Backend — Environment Variables
# Salin file ini ke .env dan isi dengan nilai asli
# JANGAN commit .env ke git!
# ================================

# Secret yang harus dikirim oleh Siagga di header X-Webhook-Secret
# Buat random string bebas, min 32 karakter
WEBHOOK_SECRET=ganti-dengan-random-string-minimal-32-karakter

# Supabase (dapatkan dari: Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Port lokal (default 3000)
PORT=3000

# ================================
# PDF Conversion (CloudConvert API)
# ================================

# Daftar di https://cloudconvert.com — free tier 25 konversi/hari
CLOUDCONVERT_API_KEY=
